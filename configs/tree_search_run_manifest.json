{
 "run_manifest_version": "clinevolve_tree_search_v1 (paper Experiment 2 configuration)",
 "selection_status": "frozen",
 "a0": {
  "model": "openai/qwen3.5-9b",
  "served_model_name": "qwen3.5-9b",
  "thinking": false,
  "temperature": 0.0,
  "max_tokens": 4096
 },
 "search": {
  "candidate_budget": 8,
  "candidate_parent_rule": "tree_search",
  "search_policy_config": {
   "content": {
    "policy_version": "exp2_formal_hgm_policy_v1",
    "alpha": 0.6,
    "initial_root_expansions": 1,
    "tau_min": 1.0,
    "tau_max": 50.0,
    "max_children_per_node": null,
    "max_evaluations_per_node": 1,
    "min_evaluations_before_expansion": 0,
    "expandable_statuses": [
     "root",
     "evaluated"
    ],
    "evaluatable_statuses": [
     "generated",
     "pending_evaluation"
    ],
    "random_seed": 20260908
   }
  },
  "controller_config": {
   "content": {
    "controller_version": "exp2_formal_controller_v1",
    "search_budget_units": 16,
    "expansion_cost_units": 1,
    "evaluation_cost_units": 1,
    "autosave_each_step": true,
    "stop_when_no_action": true
   }
  }
 },
 "candidate_modification_scope": {
  "allowed_paths": [
